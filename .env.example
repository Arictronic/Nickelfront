# =============================================================================
# Nickelfront: environment variables (.env.example)
# =============================================================================
# Notes:
# - Keep boolean/number formats consistent with what the app expects.
# - Replace placeholder secrets before production use.

# =============================================================================
# BASIC INFRASTRUCTURE
# =============================================================================

# PostgreSQL connection string (driver, user, password, host, port, database).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/nickelfront

# Redis URL for cache and service operations.
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# API AND SECURITY
# =============================================================================

# API host (0.0.0.0 = listen on all interfaces).
API_HOST=0.0.0.0

# API port.
API_PORT=8001

# Application debug mode.
DEBUG=true

# Secret key for JWT signing and other crypto operations.
SECRET_KEY=change-me-to-a-long-random-secret

# JWT signing algorithm.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins.
CORS_ORIGINS=["*"]

# =============================================================================
# CELERY AND BACKGROUND TASKS
# =============================================================================

# Delay between worker starts.
WORKER_START_GAP_SECONDS=3

# Celery Redis broker.
CELERY_BROKER_URL=redis://localhost:6380/0

# Celery result backend.
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Celery beat schedule state file.
CELERY_BEAT_SCHEDULE_FILENAME=./celerybeat-schedule

# Number of default Celery workers.
CELERY_WORKERS=1

# Number of content workers.
CONTENT_WORKERS=1

# Default worker concurrency.
WORKER_CONCURRENCY=5

# Content worker concurrency.
CONTENT_WORKER_CONCURRENCY=5

# Qwen worker concurrency.
QWEN_WORKER_CONCURRENCY=5

# Qwen worker pool type.
QWEN_WORKER_POOL=threads

# Default worker pool type.
WORKER_POOL=threads

# Content worker pool type.
CONTENT_WORKER_POOL=threads

# Queues consumed by the default worker.
WORKER_QUEUES=celery

# Max Celery task result repr length.
CELERY_TASK_RESULT_REPR_MAX_SIZE=240

# Flower port.
FLOWER_PORT=5555

# Allow unauthenticated Flower API.
FLOWER_UNAUTHENTICATED_API=true

# =============================================================================
# PARSER
# =============================================================================

# Parser schedule interval in seconds.
PARSE_SCHEDULE_INTERVAL=60

# Max items per parser run.
PARSE_LIMIT_PER_RUN=50

# Search queries for parsing.
PARSE_QUERIES=["nickel-based alloys","superalloys","heat resistant alloys"]

# =============================================================================
# VECTOR SEARCH / EMBEDDINGS
# =============================================================================

# Local ChromaDB path.
CHROMA_DB_PATH=./chroma_db

# Embedding model name.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding vector dimension.
EMBEDDING_DIM=384

# Use only local models.
EMBEDDING_LOCAL_ONLY=false

# Embedding models cache directory.
EMBEDDING_CACHE_DIR=./models

# =============================================================================
# QWEN: ACCOUNT AND MODEL
# =============================================================================

# Qwen access token.
QWEN_TOKEN=replace-with-qwen-token

# Default Qwen model.
QWEN_MODEL=qwen3.6-plus

# Enable thinking mode by default.
QWEN_THINKING_ENABLED=true

# Enable Qwen web search by default.
QWEN_SEARCH_ENABLED=true

# Allow auto-continue for long answers.
QWEN_AUTO_CONTINUE_ENABLED=true

# Maximum auto-continues for one response.
QWEN_MAX_CONTINUES=5

# Provider rate limiter interval in seconds.
QWEN_RATE_LIMIT_SECONDS=1.0

# Local API key for backend -> qwen_service communication.
QWEN_API_KEY=replace-with-local-qwen-service-key

# =============================================================================
# QWEN: STANDALONE SERVICE
# =============================================================================

# Standalone qwen_service host.
QWEN_SERVICE_HOST=127.0.0.1

# Standalone qwen_service port.
QWEN_SERVICE_PORT=8767

# Use standalone qwen_service.
QWEN_USE_STANDALONE=true

# =============================================================================
# QWEN: SHARED QUEUE (GATEWAY)
# =============================================================================

# Enable shared Celery queue for Qwen.
QWEN_QUEUE_ENABLED=true

# Qwen Celery queue name.
QWEN_QUEUE_NAME=qwen

# Timeout waiting for Qwen queue result in seconds.
QWEN_QUEUE_TIMEOUT=1000

# Celery rate limit for Qwen tasks.
QWEN_QUEUE_TASK_RATE_LIMIT=off

# Number of Qwen gateway worker processes.
QWEN_QUEUE_WORKERS=1

# Streaming retry count.
QWEN_STREAM_RETRIES=2

# Session creation attempts.
QWEN_CREATE_SESSION_ATTEMPTS=3

# Delay between session creation attempts.
QWEN_CREATE_SESSION_RETRY_DELAY_SEC=0.8

# History recovery attempts.
QWEN_HISTORY_RECOVERY_ATTEMPTS=3

# Delay between history recovery attempts.
QWEN_HISTORY_RECOVERY_INTERVAL_SEC=1.0

# Max wait for one qwen_service response in seconds.
QWEN_CHAT_TIMEOUT_SECONDS=300

# Retry Qwen requests on timeout.
QWEN_CHAT_RETRY_ON_TIMEOUT=true

# Max active Qwen chats in qwen_service memory.
QWEN_MAX_ACTIVE_SESSIONS=10

# Soft limit for concurrent real requests to chat.qwen.ai.
QWEN_PROVIDER_MAX_CONCURRENT_REQUESTS=10

# Wait time for a free provider slot.
QWEN_PROVIDER_SLOT_TIMEOUT_SEC=60

# Cache TTL for /auth/status.
QWEN_AUTH_STATUS_CACHE_TTL_SEC=60

# Provider start throttling.
QWEN_PROVIDER_START_THROTTLE_ENABLED=true
QWEN_PROVIDER_START_INTERVAL_SEC=0.50
QWEN_PROVIDER_START_JITTER_SEC=0.25

# Provider retry jitter.
QWEN_PROVIDER_RETRY_JITTER_ENABLED=true
QWEN_PROVIDER_RETRY_JITTER_MIN_SEC=0.25
QWEN_PROVIDER_RETRY_JITTER_MAX_SEC=1.25

# =============================================================================
# PARSER TRANSLATION
# =============================================================================

# Global parser translation switch.
PARSER_TRANSLATE_ENABLED=1

# Use Qwen for parser query translation.
PARSER_TRANSLATE_QWEN_ENABLED=1

# Enable translation cache.
PARSER_TRANSLATION_CACHE_ENABLED=1

# Translation cache file path.
PARSER_TRANSLATION_CACHE_PATH=parser_alpha/cache/translations/query_translations.json

# Qwen queue for translation tasks.
PARSER_TRANSLATE_QWEN_QUEUE=qwen

# Parser translation timeout in seconds.
PARSER_TRANSLATE_QWEN_TIMEOUT=1000

# =============================================================================
# RAG
# =============================================================================

# Text chunk size for indexing.
RAG_CHUNK_SIZE=1000

# Overlap between chunks.
RAG_CHUNK_OVERLAP=200

# Number of retrieved documents.
RAG_SEARCH_K=4

# Max answer tokens.
RAG_MAX_TOKENS=1024

# =============================================================================
# LOGGING
# =============================================================================

# Log level.
LOG_LEVEL=INFO

# Backend API log file path.
LOG_FILE=./logs/app.log

# Explicit backend API log file path.
BACKEND_API_LOG_FILE=./logs/app.log

# Default Celery worker log file.
CELERY_WORKER_LOG_FILE=./logs/celery_worker.log

# Content worker log file.
CONTENT_WORKER_LOG_FILE=./logs/content_worker.log

# Qwen worker log file.
QWEN_WORKER_LOG_FILE=./logs/qwen_worker.log

# parser_alpha log file.
PARSER_LOG_FILE=./logs/parser/parser_alpha.log

# Standalone qwen_service log file.
QWEN_SERVICE_LOG_FILE=./logs/qwen_service.log

# RAG API log file.
RAG_LOG_FILE=./logs/rag_api.log

# =============================================================================
# FRONTEND
# =============================================================================

# Base API URL for Vite frontend.
VITE_API_URL=/api/v1
